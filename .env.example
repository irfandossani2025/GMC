# ============================================================
# GMC Clinic Membership System - Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values.
# Never commit the real .env file to version control.

# ------------------------------------------------------------
# Database (PostgreSQL via Prisma)
# ------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME?schema=public"

# ------------------------------------------------------------
# JWT Authentication
# ------------------------------------------------------------
# A long random string used to sign authentication tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your-super-secret-jwt-key-here"

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------
NODE_ENV="production"
NEXT_PUBLIC_APP_NAME="Grand Medical Care"
NEXT_PUBLIC_APP_URL="https://yourdomain.com"

# Clinic branding (used on membership cards and notifications)
NEXT_PUBLIC_CLINIC_PHONE="+1234567890"
NEXT_PUBLIC_CLINIC_EMAIL="info@yourdomain.com"
NEXT_PUBLIC_CLINIC_ADDRESS="123 Main Street, City, Country"

# Barcode Settings
NEXT_PUBLIC_BARCODE_FORMAT="CODE128"
NEXT_PUBLIC_BARCODE_WIDTH="2"
NEXT_PUBLIC_BARCODE_HEIGHT="72"

# ------------------------------------------------------------
# WhatsApp (Meta WhatsApp Cloud API)
# ------------------------------------------------------------
# Nothing to set here. The Super Admin enters the Meta access token,
# Phone Number ID and template names in the app:
#   Dashboard -> Settings -> WhatsApp settings
# The token is stored encrypted in the database.
