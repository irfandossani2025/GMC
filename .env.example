# ============================================================
# GMC Clinic Membership System - Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values.
# Never commit the real .env file to version control.

# ------------------------------------------------------------
# Database (PostgreSQL via Prisma)
# ------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME?schema=public"

# ------------------------------------------------------------
# JWT Authentication
# ------------------------------------------------------------
# A long random string used to sign authentication tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your-super-secret-jwt-key-here"

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------
NODE_ENV="production"
NEXT_PUBLIC_APP_NAME="Grand Medical Care"
NEXT_PUBLIC_APP_URL="https://yourdomain.com"

# Clinic branding (used on membership cards and notifications)
NEXT_PUBLIC_CLINIC_PHONE="+1234567890"
NEXT_PUBLIC_CLINIC_EMAIL="info@yourdomain.com"
NEXT_PUBLIC_CLINIC_ADDRESS="123 Main Street, City, Country"

# Barcode Settings
NEXT_PUBLIC_BARCODE_FORMAT="CODE128"
NEXT_PUBLIC_BARCODE_WIDTH="2"
NEXT_PUBLIC_BARCODE_HEIGHT="72"

# ------------------------------------------------------------
# WhatsApp Notifications
# Choose ONE of the following methods:
# ------------------------------------------------------------

# --- Option A: Twilio WhatsApp API (recommended) ---
# Sign up at https://www.twilio.com/
# TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# TWILIO_AUTH_TOKEN="your_auth_token"
# TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"   # Your Twilio WhatsApp sender number

# --- Option B: WhatsApp Business Cloud API (Meta) ---
# Set up at https://developers.facebook.com/docs/whatsapp/cloud-api
# WHATSAPP_API_TOKEN="your_meta_access_token"
# WHATSAPP_PHONE_NUMBER_ID="your_phone_number_id"

# If neither option is configured, the system will generate a
# clickable wa.me link that reception staff can open manually.

# ------------------------------------------------------------
# Basic WhatsApp link fallback
# ------------------------------------------------------------
WHATSAPP_BASE_URL="https://wa.me"
WHATSAPP_DEFAULT_COUNTRY_CODE="968"
